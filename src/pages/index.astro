            <span id="modal-metric-1" class="block font-mono text-sm text-zinc-200 font-bold mt-1">---</span>
          </div>
          <div class="rounded-lg bg-zinc-900/40 border border-zinc-800 p-3">
            <span class="block font-mono text-[10px] text-zinc-500 uppercase">Production Scope</span>
            <span id="modal-metric-2" class="block font-mono text-sm text-zinc-200 font-bold mt-1">---</span>
