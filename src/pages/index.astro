</html>

<script>
  // Wrap in a DOMContentLoaded check or use delegation to guarantee execution order
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('project-modal');
    const closeBtn = document.getElementById('modal-close');

    // DOM Content Hook References
    const modalTitle = document.getElementById('modal-title');
    const modalTech = document.getElementById('modal-tech');
    const modalBody = document.getElementById('modal-body');
    const metric1 = document.getElementById('modal-metric-1');
    const metric2 = document.getElementById('modal-metric-2');

	  const mediaWrapper = document.getElementById('modal-media-wrapper');
    const modalVideo = document.getElementById('modal-video') as HTMLVideoElement | null;
    const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;

    function openModal(card: Element) {
      if (!modal || !modalTitle || !modalTech || !modalBody || !metric1 || !metric2 || !mediaWrapper) return;
      
      // Basic Text Assignments
      modalTitle.textContent = card.getAttribute('data-title') || '---';
      modalTech.textContent = card.getAttribute('data-tech') || '---';
      modalBody.textContent = card.getAttribute('data-body') || '---';
      metric1.textContent = card.getAttribute('data-metric1') || 'N/A';
      metric2.textContent = card.getAttribute('data-metric2') || 'N/A';

      // MEDIA SLOT CONTROLLER
      const mediaType = card.getAttribute('data-media-type');

      let rawMediaUrl = card.getAttribute('data-media-url') || '';

      const basePrefix = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
      const cleanUrl = rawMediaUrl.startsWith('/') ? rawMediaUrl.substring(1) : rawMediaUrl;
      const mediaUrl = cleanUrl ? basePrefix + cleanUrl : '';

      // Clear previous asset allocations first to save memory cycle pressure
      if (modalVideo) { modalVideo.src = ''; modalVideo.classList.add('hidden'); }
      if (modalImg) { modalImg.src = ''; modalImg.classList.add('hidden'); }
      mediaWrapper.classList.add('hidden');

      if (mediaUrl && mediaType) {
        mediaWrapper.classList.remove('hidden');
        
        if (mediaType === 'video' && modalVideo) {
          modalVideo.src = mediaUrl;
          modalVideo.classList.remove('hidden');
          modalVideo.load(); // Force browser engine context buffer refresh
        } else if (mediaType === 'image' && modalImg) {
          modalImg.src = mediaUrl;
          modalImg.classList.remove('hidden');
        }
      }

      // Display Modal UI Container
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
      
      // Stop video audio playback loops immediately on exit hide sequence
      if (modalVideo) { modalVideo.src = ''; }
    }

    // NATIVE EVENT DELEGATION: Intercepts clicks globally even if DOM elements load late
    document.addEventListener('click', (event) => {
      // Find if the click or any of its parent bubbles up from a project card
      const target = event.target as HTMLElement;
      const card = target.closest('.project-card');
      
      if (card) {
        openModal(card);
      }
    });

    // Close Event Handlers
    closeBtn?.addEventListener('click', closeModal);
    
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  });
</script>